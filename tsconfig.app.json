{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker", "ESNext.Disposable"],
    "allowJs": true,
    "maxNodeModuleJsDepth": 1,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"],
      "#dashboard/*": ["./dashboard/*"],
      "#generated/*": ["./.pyodide-cache/*"],
      "virtual:*": ["./vite/virtual/*/development.ts"]
    },
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "vite/virtual"]
}
