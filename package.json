{
  "name": "dashlet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "pnpm prepare:pyodide",
    "prepare:pyodide": "node vite/prepare/pyodide.ts",
    "build": "pnpm prepare:pyodide && tsc -b && vite build",
    "lint": "oxlint .",
    "format": "oxfmt --write package.json .oxlintrc.json tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts playwright.config.ts index.html .devcontainer src vite dashboard tests",
    "format:check": "oxfmt --check package.json .oxlintrc.json tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts playwright.config.ts index.html .devcontainer src vite dashboard tests",
    "precheck": "pnpm prepare:pyodide",
    "check": "pnpm lint && pnpm format:check && tsc -b",
    "test:bundle": "node tests/integration/verify-bundle.ts",
    "pretest:e2e": "pnpm build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@radix-ui/react-slider": "^1.4.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "^6.1.1",
    "async-mutex": "^0.5.0",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "lucide-react": "^1.41.0",
    "pyodide": "^314.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "packageManager": "pnpm@11.25.0"
}
