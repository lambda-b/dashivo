{
  "title": "Sales pulse",
  "description": "地域別の売上と注文状況を、ブラウザ内Pythonで集計します。",
  "analysis": {
    "inputs": [{ "id": "sales", "type": "csv", "path": "data/raw/sales.csv" }],
    "logic": [
      {
        "id": "sales-analysis",
        "type": "python",
        "path": "logic/analysis.py",
        "input": "sales",
        "outputs": { "datasets": ["summary"], "metrics": ["revenue", "orders"] }
      }
    ]
  },
  "controls": [
    {
      "type": "radio",
      "key": "region",
      "displayName": "営業地域",
      "defaultValue": "All",
      "options": [
        { "label": "すべて", "value": "All" },
        { "label": "East", "value": "East" },
        { "label": "West", "value": "West" }
      ]
    },
    {
      "type": "date-range",
      "key": "date_1",
      "displayName": "対象期間",
      "defaultValue": { "from": "2026-01-01", "to": "2026-03-31" }
    }
  ],
  "tabs": [
    {
      "id": "summary",
      "label": "サマリー",
      "contents": [
        {
          "id": "revenue",
          "type": "metric",
          "title": "売上",
          "logic": "sales-analysis",
          "metric": "revenue",
          "format": "currency",
          "emphasis": "strong"
        },
        {
          "id": "orders",
          "type": "metric",
          "title": "注文件数",
          "logic": "sales-analysis",
          "metric": "orders",
          "format": "number",
          "emphasis": "accent"
        }
      ]
    },
    {
      "id": "charts",
      "label": "グラフ",
      "contents": [
        {
          "id": "monthly-revenue",
          "type": "chart",
          "title": "月次売上",
          "logic": "sales-analysis",
          "dataset": "summary",
          "formatting": {
            "colors": ["#ca2420", "#e85d3f", "#f59e0b", "#78716c"],
            "legend": { "visible": false, "position": "bottom" },
            "gridLines": true,
            "xAxis": { "title": "", "format": "auto", "minimum": null, "maximum": null },
            "yAxis": { "title": "", "format": "number", "minimum": null, "maximum": null }
          },
          "chart": { "type": "line", "x": "date", "y": ["revenue"] }
        }
      ]
    },
    {
      "id": "tables",
      "label": "テーブル",
      "contents": [
        {
          "id": "monthly-summary",
          "type": "table",
          "title": "月次サマリー",
          "logic": "sales-analysis",
          "dataset": "summary",
          "columns": [
            { "key": "date", "label": "月" },
            { "key": "revenue", "label": "売上", "format": "currency" },
            { "key": "orders", "label": "注文件数", "format": "number" },
            { "key": "average_order_value", "label": "平均注文額", "format": "currency" }
          ]
        }
      ]
    }
  ]
}
