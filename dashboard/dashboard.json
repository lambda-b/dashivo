{
  "title": "Sales pulse",
  "description": "地域別の売上と注文状況を、ブラウザ内Pythonで集計します。",
  "controls": [
    {
      "type": "radio",
      "key": "region",
      "displayName": "営業地域",
      "defaultValue": "All",
      "options": [
        { "label": "すべて", "value": "All" },
        { "label": "East", "value": "East" },
        { "label": "West", "value": "West" }
      ]
    },
    {
      "type": "date-range",
      "key": "date_1",
      "displayName": "対象期間",
      "defaultValue": { "from": "2026-01-01", "to": "2026-03-31" }
    }
  ],
  "tabs": [
    {
      "id": "summary",
      "label": "サマリー",
      "contents": [
        {
          "id": "revenue",
          "type": "metric",
          "title": "売上",
          "metric": "revenue",
          "format": "currency",
          "emphasis": "strong"
        },
        {
          "id": "orders",
          "type": "metric",
          "title": "注文件数",
          "metric": "orders",
          "format": "number",
          "emphasis": "accent"
        }
      ]
    },
    {
      "id": "charts",
      "label": "グラフ",
      "contents": [
        {
          "id": "monthly-revenue",
          "type": "chart",
          "title": "月次売上",
          "dataset": "summary",
          "chart": { "type": "line", "x": "date", "y": ["revenue"] }
        }
      ]
    },
    {
      "id": "tables",
      "label": "テーブル",
      "contents": [
        {
          "id": "monthly-summary",
          "type": "table",
          "title": "月次サマリー",
          "dataset": "summary",
          "columns": [
            { "key": "date", "label": "月" },
            { "key": "revenue", "label": "売上", "format": "currency" },
            { "key": "orders", "label": "注文件数", "format": "number" },
            { "key": "average_order_value", "label": "平均注文額", "format": "currency" }
          ]
        }
      ]
    }
  ]
}
