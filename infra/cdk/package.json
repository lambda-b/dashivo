{
  "name": "@dashivo/infra-cdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./configuration": "./cdk.json",
    "./auth/*": "./auth/*.ts",
    "./stacks/*": "./stacks/*.ts"
