{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.infra.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "allowJs": true,
    "maxNodeModuleJsDepth": 1,
    "paths": {
      "#dashboard/*": ["../dashboard/*"],
      "#generated/*": ["../.pyodide-cache/*"]
    }
  },
  "include": ["vite", "local", "../.pyodide-cache/assets.ts"]
}
